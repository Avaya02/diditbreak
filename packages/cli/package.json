{
  "name": "diditbreak",
  "version": "0.1.1",
  "description": "Did your CLAUDE.md change make your coding agent better or worse? Runs real tasks under each context setup and measures success, cost and confusion.",
  "keywords": [
    "claude-code",
    "claude-md",
    "agents-md",
    "coding-agent",
    "ai-agents",
    "evals",
    "context-engineering",
    "llm",
    "cli",
    "ci"
  ],
  "license": "MIT",
  "author": "Avaya Sharma",
  "homepage": "https://github.com/Avaya02/diditbreak#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Avaya02/diditbreak.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Avaya02/diditbreak/issues"
  },
  "type": "module",
  "bin": {
    "diditbreak": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@diditbreak/agent-eval": "workspace:^",
    "@diditbreak/evaluator": "workspace:*",
    "@diditbreak/llm-provider": "workspace:*",
    "@diditbreak/sdk": "workspace:*",
    "@diditbreak/shared-types": "workspace:*",
    "ajv": "^8.20.0",
    "chalk": "^5.4.1",
    "execa": "^9.5.2",
    "ora": "^8.2.0",
    "p-limit": "^7.3.2",
    "sucrase": "^3.35.1",
    "tsup": "^8.5.1",
    "yargs": "^17.7.2",
    "zod": "^3.24.2"
  }
}
